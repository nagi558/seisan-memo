# PostgreSQL接続文字列（ホストからNext.js/Prisma CLIを直接実行する場合に使用）
DATABASE_URL="postgresql://seisan:seisan@localhost:5432/seisan_memo?schema=public"

# docker-compose.ymlのdbサービス（PostgreSQL）・appサービスのDATABASE_URLが
# 参照する認証情報。docker-compose.ymlには平文で書かず、この.envから注入する。
# 値は開発用のダミー例。本番運用では推測されにくい値に変更すること。
# 既存のDockerボリューム（db_data）が保持する実際の認証情報と一致させる必要があるため、
# 稼働中の環境で値を変更する場合はボリュームの再初期化が必要になる点に注意する。
POSTGRES_USER=seisan
POSTGRES_PASSWORD=seisan
POSTGRES_DB=seisan_memo

# Auth.js（NextAuth）用の暗号化シークレット
# `npx auth secret` または `openssl rand -base64 33` で生成する
AUTH_SECRET=

# Google Cloud ConsoleでOAuthクライアントを作成して取得する
# 承認済みのリダイレクトURIには {AUTH_URLまたはデプロイ先のURL}/api/auth/callback/google を登録する
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 本番環境（Docker等、Vercel以外へのセルフホスト）ではリクエストのHostヘッダーを
# 信頼するために true を設定する（開発時はNODE_ENVにより自動でtrue扱いのため不要）
AUTH_TRUST_HOST=

# セルフホスト環境で外部からアクセスするURL（Google Cloud Consoleの
# 承認済みリダイレクトURIのオリジンと一致させる）。未設定時はリクエストの
# Hostヘッダーから自動検出するが、Docker等ではコンテナのバインドアドレスが
# 検出されてしまうことがあるため明示的に設定する
AUTH_URL=
